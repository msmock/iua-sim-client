meta {
  name: test ru service registration
  type: http
  seq: 6
}

post {
  url: http://localhost:9090/simulation/v1/registration
  body: json
  auth: inherit
}

body:json {
  {
    "name": "My Simulator",
    "version": "1.2.0",
    "instanceId": "3f920a311a",
    "replicaId": "001",
    "description": "My simple simulator implementing AA-123 transaction",
    "providedInterfaces": [
      {
        "interfaceName": "Simulation Service API",
        "interfaceVersion": "1.0.0",
        "bindings": [
          {
            "@type": "REST",
            "serviceUrl": "https://my.domain.net/my-simulator"
          }
        ]
      }
    ]
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
